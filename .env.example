# Example environment variables for this project
# Copy this file to .env and fill values before running

# Your API key (required)
KEY_ONE=your_api_key_here
# Optional: alternate name
# API_KEY=your_api_key_here

# The AI endpoint to call (defaults to Google Gemini example)
# API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# If true, the key will be sent as ?key=... in the query string. If false, the key is sent as Bearer token.
USE_KEY_IN_QUERY=true

# Tweak timeouts and retries
REQUEST_TIMEOUT=15
RETRIES=2
BACKOFF_SECONDS=1.5
